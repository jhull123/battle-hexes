# Docker build context for the API image
# Ignore git and local environments
.git
.github
.env
*.venv
.venv*/
**/.venv*/
__pycache__
*.pyc

# Exclude tests and development scripts
**/tests
**/checks.sh

# Frontend not needed for API image
battle-hexes-web
# The API image serves ARM64 only; x86 training output stays in Git, not the image.
battle_agent_rl/archive/ppo/x86_64
battle_agent_rl/archive/ppo/*/evaluation.json
